<Window x:Class="WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Main Window" Height="450" Width="800">

    <!-- Основной Grid -->
    <Grid>
        <!-- Определение колонок -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Боковая панель навигации -->
        <Border Background="#2D2D2D" Grid.Column="0">
            <StackPanel>
                <TextBlock Text="Welcome!" Foreground="White" FontSize="24" Margin="20" HorizontalAlignment="Center"/>
                <Button Content="Home" Height="50" Margin="10" Foreground="White" Background="#3C3F41" BorderBrush="Transparent" FontSize="16"/>
                <Button Content="Settings" Height="50" Margin="10" Foreground="White" Background="#3C3F41" BorderBrush="Transparent" FontSize="16"/>
                <Button Content="About" Height="50" Margin="10" Foreground="White" Background="#3C3F41" BorderBrush="Transparent" FontSize="16"/>
                <Button Content="Exit" Height="50" Margin="10" Foreground="White" Background="#3C3F41" BorderBrush="Transparent" FontSize="16"/>
            </StackPanel>
        </Border>

        <!-- Основное содержимое окна -->
        <Grid Grid.Column="1">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="black" Offset="0"/>
                    <GradientStop Color="gray" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Заголовок страницы -->
            <TextBlock Text="Main Page" Foreground="White" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0"/>

            <!-- Контент -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Content="Click Me!" Width="200" Height="50" Background="#00BFFF" Foreground="White" FontSize="18" BorderBrush="Transparent" Margin="0,10"/>
                <Button Content="Learn More" Width="200" Height="50" Background="#32CD32" Foreground="White" FontSize="18" BorderBrush="Transparent" Margin="0,10"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
